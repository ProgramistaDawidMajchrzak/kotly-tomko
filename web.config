<?xml version="1.0" encoding="UTF-8"?>
<!-- Konfiguracja IIS (Webio) — odpowiednik .htaccess -->
<configuration>
  <system.webServer>

    <!-- Najpierw nowa strona, a nie Default.aspx ze starego hostingu -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />

    <rewrite>
      <rules>
        <!-- Włączyć (enabled="true") DOPIERO po zainstalowaniu certyfikatu SSL -->
        <rule name="HTTPS i domena bez www" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect" url="https://kotlytomko.pl/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Adresy starej strony (mogą być w Google i zakładkach) → odpowiednie sekcje nowej -->
        <rule name="Stara strona: index" stopProcessing="true">
          <match url="^(index\.htm|postinfo\.html)$" ignoreCase="true" />
          <action type="Redirect" url="/" redirectType="Permanent" />
        </rule>
        <rule name="Stara strona: oferta" stopProcessing="true">
          <match url="^oferta\.htm$" ignoreCase="true" />
          <action type="Redirect" url="/#uslugi" redirectType="Permanent" />
        </rule>
        <rule name="Stara strona: o firmie" stopProcessing="true">
          <match url="^ofirmie\.htm$" ignoreCase="true" />
          <action type="Redirect" url="/#o-firmie" redirectType="Permanent" />
        </rule>
        <rule name="Stara strona: galeria" stopProcessing="true">
          <match url="^galeria(\.htm|/.*)?$" ignoreCase="true" />
          <action type="Redirect" url="/#realizacje" redirectType="Permanent" />
        </rule>
        <rule name="Stara strona: kontakt" stopProcessing="true">
          <match url="^kontakt\.htm$" ignoreCase="true" />
          <action type="Redirect" url="/#kontakt" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Plik z hasłem SMTP nie może być dostępny z przeglądarki -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="kontakt-config.php" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="Referrer-Policy" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <remove name="Permissions-Policy" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Długi cache dla zdjęć, fontów, CSS i JS (wersjonowane parametrem ?v=) -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
